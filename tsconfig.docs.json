{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/core/*/src/**/*",
    "packages/modules/*/src/**/*"
  ],
  "exclude": [
    "packages/core/*/dist/**/*",
    "packages/modules/*/dist/**/*",
    "packages/**/node_modules",
    "packages/**/*.spec.ts",
    "packages/**/*.test.ts"
  ]
}
