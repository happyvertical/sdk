{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "../packages/core/types/src/**/*",
    "../packages/core/utils/src/**/*",
    "../packages/core/logger/src/**/*",
    "../packages/core/files/src/**/*",
    "../packages/core/cache/src/**/*",
    "../packages/core/geo/src/**/*",
    "../packages/core/translator/src/**/*",
    "../packages/core/sql/src/**/*",
    "../packages/core/ocr/src/**/*",
    "../packages/core/pdf/src/**/*",
    "../packages/core/ai/src/**/*",
    "../packages/core/spider/src/**/*",
    "../packages/core/smrt/src/**/*",
    "../packages/modules/tags/src/**/*",
    "../packages/modules/places/src/**/*",
    "../packages/modules/profiles/src/**/*",
    "../packages/modules/events/src/**/*",
    "../packages/modules/assets/src/**/*",
    "../packages/modules/gnode/src/**/*",
    "../packages/modules/content/src/**/*",
    "../packages/modules/products/src/**/*"
  ],
  "exclude": [
    "src/**/*",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/dist/**",
    "**/build/**"
  ]
}
