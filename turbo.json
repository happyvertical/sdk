{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["PUBLISH_PACK_OUTPUT_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/vite.config.base.ts",
        "src/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/vite.config.base.ts",
        "$TURBO_ROOT$/vitest.package.config.ts",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "src/**",
        "test/**",
        "**/*.test.ts",
        "**/*.spec.ts",
        "package.json",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:optional": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:postgres": {
      "dependsOn": ["^build"],
      "env": [
        "CI_POSTGRES_BASE_URL",
        "DATABASE_URL",
        "TEST_DB_URL",
        "TEST_DB_ADAPTER",
        "HAVE_SQL_URL",
        "SQLOO_URL",
        "PGHOST",
        "PGPORT",
        "PGUSER",
        "PGPASSWORD",
        "PGDATABASE",
        "NODE_ENV"
      ],
      "cache": false
    },
    "lint": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "biome.json"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "**/*.ts", "tsconfig.json"],
      "outputs": []
    },
    "docs": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "README.md", "AGENT.md", "package.json"],
      "outputs": ["docs/**", "manual/**"]
    },
    "docs:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "prebuild": {
      "cache": false
    },
    "postbuild": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
