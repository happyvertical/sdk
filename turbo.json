{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/vite.config.base.ts",
        "src/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "**/*.test.ts", "**/*.spec.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:optional": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "biome.json"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "**/*.ts", "tsconfig.json"],
      "outputs": []
    },
    "docs": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "README.md", "AGENT.md", "package.json"],
      "outputs": ["docs/**", "manual/**"]
    },
    "docs:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "prebuild": {
      "cache": false
    },
    "postbuild": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
