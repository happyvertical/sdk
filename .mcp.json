{
  "mcpServers": {
    "smrt-advisor": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "/Users/will/Work/happyvertical/repos/sdk/scripts/mcp-servers/smrt-dev-server.sh"
      ],
      "env": {
        "SDK_ROOT": "/Users/will/Work/happyvertical/repos/sdk",
        "DEBUG": "false"
      }
    },
    "mcp-svelte-docs": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-svelte-docs"
      ],
      "env": {}
    },
    "shadcn-ui": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "shadcn-mcp",
        "--framework",
        "svelte"
      ],
      "env": {
        "FRAMEWORK": "svelte"
      }
    }
  }
}