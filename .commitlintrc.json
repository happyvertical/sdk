{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "ai",
        "cache",
        "ci",
        "config",
        "content",
        "documents",
        "files",
        "geo",
        "git",
        "gnode",
        "logger",
        "ocr",
        "pdf",
        "products",
        "smrt",
        "spider",
        "sql",
        "translator",
        "utils",
        "weather",
        "deps",
        "release"
      ]
    ],
    "subject-case": [
      2,
      "never",
      ["upper-case", "pascal-case", "start-case"]
    ],
    "subject-full-stop": [2, "never", "."],
    "subject-empty": [2, "never"],
    "type-case": [2, "always", "lowercase"],
    "type-empty": [2, "never"],
    "header-max-length": [2, "always", 100],
    "body-leading-blank": [2, "always"],
    "footer-leading-blank": [2, "always"]
  }
}
