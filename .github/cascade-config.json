{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Dependency cascade configuration for HappyVertical repositories",
  "cascade": {
    "sdk": {
      "repository": "happyvertical/sdk",
      "triggers": ["smrt"],
      "packages": ["@happyvertical/*"]
    },
    "smrt": {
      "repository": "happyvertical/smrt",
      "triggers": ["praeco", "caelus"],
      "packages": ["@happyvertical/smrt"],
      "dependencies": ["sdk"]
    },
    "praeco": {
      "repository": "happyvertical/praeco",
      "triggers": ["bentleyalberta"],
      "packages": [],
      "dependencies": ["sdk", "smrt"]
    },
    "caelus": {
      "repository": "happyvertical/caelus",
      "triggers": ["bentleyalberta"],
      "packages": [],
      "dependencies": ["sdk", "smrt"]
    },
    "bentleyalberta": {
      "repository": "blindmanpress/bentleyalberta.com",
      "triggers": [],
      "packages": [],
      "dependencies": ["praeco"]
    }
  },
  "settings": {
    "auto_merge": {
      "enabled": true,
      "require_tests": true,
      "require_build": true
    },
    "notifications": {
      "on_failure": true,
      "on_success": false
    },
    "timeouts": {
      "test_timeout_minutes": 30,
      "cascade_timeout_hours": 24
    }
  }
}
