{
  "name": "@happyvertical/auth",
  "version": "0.69.1",
  "description": "Unified authentication interface supporting Keycloak, AWS Cognito, and Nostr with OAuth2/OIDC and public key identity",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "have-auth-context": "./dist/cli/claude-context.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    ".claude-meta.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/sdk.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/sdk/issues"
  },
  "homepage": "https://github.com/happyvertical/sdk/tree/main/packages/auth#readme",
  "license": "MIT",
  "scripts": {
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "clean": "rm -rf dist docs"
  },
  "dependencies": {
    "@happyvertical/utils": "workspace:*",
    "jose": "^6.1.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.978.0",
    "nostr-tools": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^4.0.18"
  }
}
