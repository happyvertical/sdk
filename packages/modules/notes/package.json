{
  "name": "@have/notes",
  "version": "0.23.1",
  "type": "module",
  "description": "Hierarchical note-taking system for SMRT objects with confidence tracking and versioning",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@have/smrt": "workspace:*"
  },
  "devDependencies": {
    "@have/types": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "notes",
    "smrt",
    "hierarchy",
    "knowledge",
    "discovery",
    "learning",
    "confidence-tracking"
  ]
}
