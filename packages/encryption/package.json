{
  "name": "@happyvertical/encryption",
  "version": "0.80.0",
  "description": "Unified encryption and cryptography operations with adapter-based architecture",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "have-encryption-context": "./dist/cli/claude-context.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENT.md",
    "metadata.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --config ../../vitest.package.config.ts run",
    "test:watch": "vitest --config ../../vitest.package.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@happyvertical/logger": "workspace:*",
    "@happyvertical/utils": "workspace:*",
    "@openpgp/web-stream-tools": "^0.3.1",
    "openpgp": "^6.3.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10"
  },
  "keywords": [
    "encryption",
    "cryptography",
    "pgp",
    "openpgp",
    "nacl",
    "crypto",
    "security"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/sdk.git",
    "directory": "packages/encryption"
  }
}
