{
  "name": "@happyvertical/secrets",
  "version": "0.66.8",
  "description": "Envelope encryption for per-tenant secret management with pluggable backends",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
