{
  "name": "@happyvertical/weather",
  "version": "0.59.0",
  "description": "Weather data provider abstraction for HAppyVertical SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:optional": "vitest run --testNamePattern=\"\\.optional\\.test\\.ts\"",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [
    "weather",
    "forecast",
    "openweathermap",
    "environment-canada",
    "happyvertical",
    "sdk"
  ],
  "author": "HAppyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/sdk.git",
    "directory": "packages/weather"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^4.0.8"
  }
}
