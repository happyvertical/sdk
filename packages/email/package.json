{
  "name": "@happyvertical/email",
  "version": "0.85.5",
  "description": "Low-level email protocol operations with adapter-based architecture",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "have-email-context": "./dist/cli/claude-context.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENT.md",
    "metadata.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --config ../../vitest.package.config.ts run",
    "test:watch": "vitest --config ../../vitest.package.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@happyvertical/logger": "workspace:*",
    "@happyvertical/utils": "workspace:*",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.22",
    "node-pop3": "^0.15.0",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "25.9.5",
    "@types/nodemailer": "^8.0.1",
    "smtp-server": "^3.19.8",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.10"
  },
  "keywords": [
    "email",
    "smtp",
    "imap",
    "pop3",
    "gmail",
    "protocol"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/sdk.git",
    "directory": "packages/email"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/sdk/issues"
  },
  "homepage": "https://github.com/happyvertical/sdk/tree/main/packages/email#readme"
}
